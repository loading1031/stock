# 복사해서 .env로 만들고 값을 채운다: cp .env.example .env
# .env는 커밋하지 않는다(.gitignore). 이 파일에는 값을 넣지 않는다.
# 변수 이름은 제안이다. M0(DB)·B-02(KIS)에서 실제 코드에 맞춰 확정한다.

# --- 로컬 DB (m0-foundation.md: 소유자 계정은 Flyway, 앱 계정은 애플리케이션) ---
DB_OWNER_PASSWORD=
DB_APP_PASSWORD=

# --- KIS 모의투자 (B-02 검증 스크립트용. 실전 키를 넣지 않는다) ---
KIS_PAPER_APP_KEY=
KIS_PAPER_APP_SECRET=
# 계좌번호 앞 8자리, 계좌 상품코드(뒤 2자리. 보통 01)
KIS_PAPER_ACCOUNT_NO=
KIS_PAPER_ACCOUNT_PRODUCT_CODE=
# HTS 아이디. 체결통보(H0STCNI9) 구독 키로 쓴다
KIS_HTS_ID=

# --- KIS 선물 모의투자 (국내선물옵션 모의 계좌는 앱키가 따로다) ---
KIS_PAPER_FUTURES_APP_KEY=
KIS_PAPER_FUTURES_APP_SECRET=
# 앞 8자리 또는 8-2 형태. 뒤 2자리는 아래 변수로 따로 줘도 되고, 없으면 03
KIS_PAPER_FUTURES_ACCOUNT_NO=
KIS_PAPER_FUTURES_PRODUCT_CODE=

# --- KIS 실전 키: 해외선물 시세 조회 전용 (읽기 전용) ---
# scripts/kis-probe의 RealReadOnlyClient만 쓴다. GET과 선물 시세 경로만 코드로 허용하고
# 주문·계좌·정정·취소에는 절대 쓰지 않는다. 앱 코드에 연결하기 전에 B-10(비밀 관리)에서 다시 정한다.
KIS_APP_KEY=
KIS_APP_SECRET=
