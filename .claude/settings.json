      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.*.local)",
      "Read(./.env.development)",
      "Read(./.env.production)",
      "Read(./.env.test)"
    ]
  },
  "enabledPlugins": {
    "planning@loading1031-plugins": true,
